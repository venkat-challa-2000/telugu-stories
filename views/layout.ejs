<!DOCTYPE html>
<html lang="te">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'తెలుగు కథలు' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background-color: #fbf9f4; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #333; }
    .header-bar { background-color: #6a1b1a; border-bottom: 2px solid #521514; }
    .search-input { background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.2); color: white; border-radius: 20px; }
    .search-input::placeholder { color: #ddd; }
    .search-input:focus { background: rgba(0, 0, 0, 0.35); color: white; box-shadow: none; border-color: rgba(255, 255, 255, 0.5); }
    .btn-maroon { background-color: #6a1b1a; color: white; }
    .btn-maroon:hover { background-color: #521514; color: white; }
    .sidebar-card { background: #ffffff; border: 1px solid #eee; border-radius: 12px; }
    .invite-box { background-color: #fff3cd; border: 1px solid #ffeeba; border-radius: 12px; }
  </style>
</head>
<body class="d-flex flex-column min-vh-100">

  <!-- Main Top Header -->
  <header class="header-bar py-2 text-white">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
      <a href="/" class="text-white text-decoration-none d-flex align-items-center gap-2">
        <span class="fs-3">📖</span>
        <span class="fw-bold fs-4">తెలుగు కథలు</span>
      </a>

      <!-- Middle Search Bar -->
      <form action="/" method="GET" class="d-flex align-items-center flex-grow-1 mx-lg-4" style="max-width: 450px;">
        <div class="input-group">
          <input type="text" name="search" class="form-control form-control-sm search-input px-3" placeholder="కథ లేదా రచయిత పేరును వెతకండి..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
          <button class="btn btn-sm btn-outline-light rounded-pill ms-1" type="submit"><i class="fa fa-search"></i></button>
        </div>
      </form>

      <!-- Right Navigation Buttons -->
      <div class="d-flex align-items-center gap-2">
        <a href="/" class="btn btn-sm btn-outline-light border-0">హోమ్ (Home)</a>
        <% if (currentUser) { %>
          <a href="/submit" class="btn btn-sm btn-maroon border border-white text-white fw-bold">+ మీ రచన పంపండి</a>
          <a href="/my-dashboard" class="btn btn-sm btn-warning text-dark fw-bold">నా డాష్‌బోర్డ్</a>
          <% if (currentUser.is_admin) { %>
            <a href="/admin/writers" class="btn btn-sm btn-info text-dark fw-bold">రచయితలు (Admin)</a>
          <% } %>
          <a href="/logout" class="btn btn-sm btn-outline-light">లాగౌట్</a>
        <% } else { %>
          <a href="/login" class="btn btn-sm btn-outline-light">లాగిన్</a>
          <a href="/register" class="btn btn-sm btn-warning text-dark fw-bold">ఖాతా తెరవండి</a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Page Body -->
  <main class="container my-4 flex-grow-1">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="bg-dark text-white text-center py-4 mt-auto">
    <div class="container">
      <small>© 2026 తెలుగు కథలు. సర్వహక్కులు ప్రత్యేకించబడినవి.</small>
      <div class="mt-2">
        <a href="/about" class="text-white-50 text-decoration-none mx-2">మా గురించి (About Us)</a>
        <a href="/privacy" class="text-white-50 text-decoration-none mx-2">గోప్యతా విధానం (Privacy Policy)</a>
        <a href="/contact" class="text-white-50 text-decoration-none mx-2">మమ్మల్ని సంప్రదించండి (Contact Us)</a>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>