<div class="row justify-content-center my-4">
  <div class="col-md-5 col-lg-4">
    <div class="card shadow-sm p-4 bg-white border">
      <h3 class="text-center fw-bold mb-3" style="color: #6a1b1a;">కొత్త పాస్‌వర్డ్</h3>

      <% if (error) { %>
        <div class="alert alert-danger py-2 small"><%= error %></div>
      <% } %>

      <form action="/reset-password/<%= token %>" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold">కొత్త పాస్‌వర్డ్</label>
          <input type="password" name="password" class="form-control" placeholder="కనీసం 6 అక్షరాలు" required>
        </div>
        <button type="submit" class="btn btn-maroon w-100 py-2 fw-semibold">పాస్‌వర్డ్ మార్చండి</button>
      </form>
    </div>
  </div>
</div>