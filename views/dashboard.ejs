<div class="card p-4 shadow-sm bg-white border-0 my-3">
  <div class="mb-4">
    <h3 class="fw-bold" style="color: #6a1b1a;">రచయిత డ్యాష్‌బోర్డ్ (My Dashboard)</h3>
    <p class="text-muted mb-0">నమస్కారం <b><%= currentUser.username %></b>! మీ రచనల గణాంకాలు మరియు పాఠకుల సందేశాలు ఇక్కడ ఉన్నాయి.</p>
  </div>

  <!-- Uploaded Stories -->
  <div class="mb-5">
    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
      <span>📚</span> <span>మీరు అప్‌లోడ్ చేసిన కథలు (<%= myStories.length %>)</span>
    </h5>
    <div class="table-responsive">
      <table class="table table-hover align-middle border">
        <thead class="table-light">
          <tr>
            <th>శీర్షిక (Story Title)</th>
            <th>విభాగం</th>
            <th>వీక్షణలు (Views)</th>
            <th>లైకులు (Likes)</th>
            <th>సమీక్షలు (Comments)</th>
            <th>తేదీ</th>
            <th>చూడండి</th>
          </tr>
        </thead>
        <tbody>
          <% if (myStories && myStories.length > 0) { %>
            <% myStories.forEach(s => { %>
              <tr>
                <td class="fw-bold"><%= s.title %></td>
                <td><span class="badge bg-light text-dark border"><%= s.category %></span></td>
                <td><i class="fa fa-eye text-primary"></i> <%= s.views %></td>
                <td><i class="fa fa-heart text-danger"></i> <%= s.likes %></td>
                <td><i class="fa fa-comment text-secondary"></i> <%= s.total_comments %></td>
                <td><%= new Date(s.created_at).toLocaleDateString('te-IN') %></td>
                <td><a href="/story/<%= s.slug %>" class="text-decoration-none fw-semibold" style="color: #6a1b1a;">ఓపెన్ →</a></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center text-muted py-4">మీరు ఇంకా ఏ కథలూ ప్రచురించలేదు.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Reader Private Messages -->
  <div>
    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
      <span>✉️</span> <span>పాఠకుల నుండి వచ్చిన ప్రైవేట్ సందేశాలు (<%= receivedMessages.length %>)</span>
    </h5>
    <% if (receivedMessages && receivedMessages.length > 0) { %>
      <div class="d-flex flex-column gap-3">
        <% receivedMessages.forEach(m => { %>
          <div class="p-3 bg-light rounded border">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="fw-bold text-dark">👤 <%= m.sender_name %></span>
              <small class="text-muted"><%= new Date(m.created_at).toLocaleString('te-IN') %></small>
            </div>
            <% if (m.story_title) { %>
              <div class="small text-muted mb-2">
                సంబంధిత రచన: <a href="/story/<%= m.story_slug %>" class="fw-semibold text-decoration-none" style="color: #6a1b1a;"><%= m.story_title %></a>
              </div>
            <% } %>
            <p class="mb-0 text-dark bg-white p-2 rounded border-start border-3 border-danger"><%= m.message %></p>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-4 text-center text-muted border rounded bg-light">
        ఇంకా ఎటువంటి వ్యక్తిగత సందేశాలూ రాలేదు. పాఠకులు మీకు మెసేజ్ పంపినప్పుడు ఇక్కడ కనిపిస్తాయి.
      </div>
    <% } %>
  </div>
</div>