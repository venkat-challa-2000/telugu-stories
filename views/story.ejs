<%- include('layout', { body: `
  <article class="bg-white p-6 md:p-10 rounded-2xl shadow-sm border border-stone-200 mb-8 max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-4">
      <span class="text-xs uppercase bg-amber-100 text-amber-900 px-3 py-1 rounded-full font-bold">📁 ${story.category || 'కథ'}</span>
      ${currentUser && currentUser.is_admin ? `
        <form action="/story/${story.id}/delete" method="POST" onsubmit="return confirm('Admin: ఈ కథను డిలీట్ చేయాలా?');">
          <button type="submit" class="bg-red-600 text-white text-xs px-3 py-1.5 rounded-lg font-bold hover:bg-red-700">Delete Story (Admin)</button>
        </form>
      ` : ''}
    </div>

    <h1 class="text-2xl md:text-4xl font-extrabold text-stone-900 mb-3 telugu-title leading-snug">${story.title}</h1>
    
    <div class="text-xs text-stone-500 mb-6 pb-4 border-b flex flex-wrap items-center gap-3">
      <span>✍️ రచయిత: <strong class="text-stone-800">${story.author_name}</strong></span>
      <span>•</span>
      <span>📅 ప్రచురణ: ${new Date(story.created_at).toLocaleDateString()}</span>
      <span>•</span>
      <span class="bg-amber-100 text-amber-900 px-2 py-0.5 rounded font-semibold">👁️ ${story.views || 0} వీక్షణలు</span>
      <span>•</span>
      <span class="bg-red-50 text-red-700 px-2 py-0.5 rounded font-semibold">❤️ ${story.likes || 0} లైకులు</span>
    </div>

    ${story.image_url ? `
      <div class="mb-8 rounded-xl overflow-hidden max-h-96 w-full shadow-sm">
        <img src="${story.image_url}" alt="${story.title}" class="w-full h-full object-cover">
      </div>
    ` : ''}

    <div class="text-stone-800 text-base md:text-lg leading-relaxed whitespace-pre-line mb-8 font-serif">
      ${story.content}
    </div>

    <!-- Action Bar: Like & Chat with Writer Button -->
    <div class="pt-6 border-t border-stone-100 flex flex-wrap items-center justify-between gap-4">
      <!-- Like Button -->
      <form action="/story/${story.slug}/like" method="POST">
        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
          <span>❤️</span> లైక్ చేయండి (${story.likes || 0})
        </button>
      </form>

      <!-- Private Chat Trigger -->
      ${currentUser ? `
        ${currentUser.id !== story.author_id ? `
          <button onclick="document.getElementById('chatSection').scrollIntoView({ behavior: 'smooth' })" class="bg-amber-500 hover:bg-amber-400 text-stone-950 px-4 py-2 rounded-xl text-xs font-bold shadow transition flex items-center gap-1.5">
            <span>💬</span> రచయితతో ప్రైవేట్ చాట్ (Chat with Writer)
          </button>
        ` : `
          <span class="text-xs text-stone-400 italic">మీరు ఈ కథ యొక్క రచయిత.</span>
        `}
      ` : `
        <a href="/login" class="text-xs text-red-800 font-bold hover:underline">రచయితతో చాట్ చేయడానికి లాగిన్ అవ్వండి →</a>
      `}
    </div>
  </article>

  <!-- PRIVATE CHAT WITH WRITER BOX -->
  ${currentUser && currentUser.id !== story.author_id ? `
    <div id="chatSection" class="max-w-3xl mx-auto bg-gradient-to-br from-amber-50 to-orange-50 p-6 md:p-8 rounded-2xl border border-orange-200 shadow-sm mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-2xl">✉️</span>
        <h3 class="text-lg font-bold text-stone-900">రచయిత ${story.author_name} గారికి ప్రైవేట్ మెసేజ్ పంపండి</h3>
      </div>
      <p class="text-xs text-stone-600 mb-4">ఈ సందేశం పబ్లిక్‌గా కనిపించదు. రచయిత తన ప్రైవేట్ డాష్‌బోర్డ్‌లో మాత్రమే చూసి మీకు సమాధానం (Reply) ఇవ్వగలరు.</p>

      <form action="/messages/send" method="POST" class="space-y-3">
        <input type="hidden" name="receiver_id" value="${story.author_id}">
        <input type="hidden" name="story_id" value="${story.id}">
        <input type="hidden" name="redirect_url" value="/story/${story.slug}">
        <textarea name="message" rows="3" required placeholder="రచయితకు మీ వ్యక్తిగత సందేశం ఇక్కడ రాయండి..." class="w-full border border-orange-300 p-3 rounded-xl text-xs md:text-sm outline-none bg-white focus:ring-2 focus:ring-orange-400"></textarea>
        <button type="submit" class="bg-stone-900 text-white px-5 py-2.5 rounded-xl text-xs font-bold hover:bg-stone-800 transition shadow">
          మెసేజ్ పంపండి (Send Message)
        </button>
      </form>
    </div>
  ` : ''}

  <!-- Readers Public Feedback -->
  <section class="max-w-3xl mx-auto bg-white p-6 md:p-8 rounded-2xl border border-stone-200 shadow-sm">
    <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
      <span>💬</span> బహిరంగ సమీక్షలు (Public Comments)
    </h3>

    <form action="/story/${story.slug}/comment" method="POST" class="mb-8 space-y-3">
      ${!currentUser ? '<input type="text" name="name" placeholder="మీ పేరు" required class="w-full border p-2.5 rounded-xl text-xs md:text-sm outline-none">' : ''}
      <textarea name="comment" rows="3" placeholder="ఈ కథపై మీ సమీక్షను ఇక్కడ రాయండి..." required class="w-full border p-3 rounded-xl text-xs md:text-sm outline-none focus:ring-2 focus:ring-red-900"></textarea>
      <button type="submit" class="bg-stone-900 text-white px-5 py-2 rounded-xl text-xs font-bold hover:bg-stone-800">సమీక్షను పంపండి</button>
    </form>

    <div class="space-y-3">
      ${comments.length === 0 ? '<p class="text-stone-400 text-xs">ఇంకా ఎటువంటి సమీక్షలు లేవు. మొదటి సమీక్షను మీరే ఇవ్వండి!</p>' : ''}
      ${comments.map(c => `
        <div class="p-4 bg-stone-50 rounded-xl border border-stone-100">
          <div class="flex justify-between items-center mb-1">
            <span class="font-bold text-stone-800 text-xs">${c.author_name}</span>
            <span class="text-[10px] text-stone-400">${new Date(c.created_at).toLocaleDateString()}</span>
          </div>
          <p class="text-stone-700 text-xs md:text-sm leading-relaxed">${c.comment}</p>
        </div>
      `).join('')}
    </div>
  </section>
` }) %>