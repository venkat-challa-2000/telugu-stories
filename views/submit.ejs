<div class="row justify-content-center my-4">
  <div class="col-lg-9 col-md-10">
    <div class="card shadow-sm p-4 p-md-5 bg-white border rounded-3">
      
      <!-- Page Header -->
      <div class="mb-4 pb-3 border-bottom">
        <h2 class="fw-bold mb-2" style="color: #6a1b1a;">✍️ మీ రచనను సమర్పించండి</h2>
        <p class="text-muted mb-0">శీర్షిక, విభాగం, కథ లేదా కవిత వివరాలను పూర్తి చేయండి. సమర్పించిన వెంటనే పాఠకులకు కనిపిస్తుంది.</p>
      </div>

      <!-- Submit Form -->
      <form action="/submit" method="POST" enctype="multipart/form-data">
        
        <!-- Story Title -->
        <div class="mb-4">
          <label class="form-label fw-bold">రచన శీర్షిక (Title) <span class="text-danger">*</span></label>
          <input 
            type="text" 
            name="title" 
            class="form-control form-control-lg fs-6" 
            placeholder="ఆకర్షణీయమైన శీర్షికను రాయండి (ఉదా: నిజాయితీకి తగిన బహుమతి)" 
            required
          >
        </div>

        <div class="row">
          <!-- Category Selection -->
          <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">విభాగం ఎంచుకోండి (Category) <span class="text-danger">*</span></label>
            <select name="category" class="form-select form-select-lg fs-6" required>
              <option value="" disabled selected>విభాగాన్ని ఎంచుకోండి...</option>
              <option value="నీతి కథలు">నీతి కథలు</option>
              <option value="పిట్ట కథలు">పిట్ట కథలు</option>
              <option value="హాస్య కథలు">హాస్య కథలు</option>
              <option value="కవితలు">కవితలు</option>
              <option value="జీవిత సత్యాలు">జీవిత సత్యాలు</option>
              <option value="ప్రేమకథలు">ప్రేమకథలు</option>
              <option value="భయానక కథలు">భయానక కథలు</option>
              <option value="సాధారణ కథలు">సాధారణ కథలు</option>
            </select>
          </div>

          <!-- Cover Image Upload -->
          <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">కథ ఫోటో (Optional Cover Image)</label>
            <input type="file" name="coverImage" class="form-control form-control-lg fs-6" accept="image/*">
            <small class="text-muted d-block mt-1">PNG, JPG లేదా WEBP ఫార్మాట్ ఎంచుకోవచ్చు.</small>
          </div>
        </div>

        <!-- Story Content (Wide & Clear) -->
        <div class="mb-4">
          <label class="form-label fw-bold">రచన వివరాలు (Content) <span class="text-danger">*</span></label>
          <textarea 
            name="content" 
            class="form-control" 
            rows="12" 
            style="line-height: 1.8; font-size: 1.05rem;" 
            placeholder="మీ పూర్తి రచన లేదా కవితను ఇక్కడ టైప్ చేయండి లేదా పేస్ట్ చేయండి..." 
            required
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
          <a href="/" class="btn btn-outline-secondary px-4 py-2">రద్దు చేయండి (Cancel)</a>
          <button type="submit" class="btn btn-maroon px-5 py-2 fs-5 fw-bold shadow-sm">
            🚀 ప్రచురించండి (Publish Story)
          </button>
        </div>

      </form>
    </div>
  </div>
</div>