<div class="row justify-content-center my-4">
  <div class="col-md-5 col-lg-4">
    <div class="card shadow-sm p-4 bg-white border">
      <h3 class="text-center fw-bold mb-3" style="color: #6a1b1a;">పాస్‌వర్డ్ రీసెట్</h3>
      <p class="text-muted small text-center mb-3">మీ నమోదిత ఈమెయిల్ ఐడీని నమోదు చేయండి. మేము రీసెట్ లింక్‌ను పంపుతాము.</p>

      <% if (error) { %>
        <div class="alert alert-danger py-2 small"><%= error %></div>
      <% } %>
      <% if (message) { %>
        <div class="alert alert-success py-2 small"><%= message %></div>
      <% } %>

      <form action="/forgot-password" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold">ఈమెయిల్ ఐడీ</label>
          <input type="email" name="email" class="form-control" placeholder="name@example.com" required>
        </div>
        <button type="submit" class="btn btn-maroon w-100 py-2 fw-semibold">రీసెట్ లింక్ పంపండి</button>
      </form>

      <div class="text-center mt-3">
        <a href="/login" class="small text-decoration-none" style="color: #6a1b1a;">← లాగిన్ పేజీకి తిరిగి వెళ్లండి</a>
      </div>
    </div>
  </div>
</div>